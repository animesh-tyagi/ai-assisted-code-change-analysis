# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Java / Maven (parser service, M2)
target/
.mvn/wrapper/maven-wrapper.jar

# Environment
.env
.env.local
.env.*.local

# Test / coverage
coverage/
.vitest/

# Local workspaces used by the worker (ARCHITECTURE §4). Not anchored to the
# repo root: WORKSPACE_ROOT="./data" resolves relative to whatever directory
# actually started the worker process, which is worker/ when run via
# `npm run dev --workspace @impact/worker` (root-relative only when invoked
# directly via `tsx worker/src/index.ts`) — so this needs to match `data/`
# at any depth, not just at the root.
data/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
