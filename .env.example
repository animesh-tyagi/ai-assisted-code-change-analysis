# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Local infrastructure (docker-compose.yml) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=impact
REDIS_URL=redis://localhost:6379

# --- Parser service (ARCHITECTURE §8) — built in M2 ---
PARSER_URL=http://localhost:8080

# --- API ---
PORT=3000

# --- LLM (ARCHITECTURE §11) — wired in M5 ---
# Gemini 3.6 Flash, behind the LLMProvider interface.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# --- GitHub App (ARCHITECTURE §9, D7) — wired in M6 ---
# No PAT: the app mints short-lived per-installation tokens from the private key.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Worker workspaces (ARCHITECTURE §4) ---
WORKSPACE_ROOT=./data
