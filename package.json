{
  "name": "ai-assisted-code-change-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "api",
    "worker",
    "eval"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev:api": "npm run dev --workspace @impact/api",
    "dev:worker": "npm run dev --workspace @impact/worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
